# Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alatujidb
DB_USER=postgres
DB_PASSWORD=adhimix

# ============================================================================
# SELENIUM/WEB AUTOMATION CONFIGURATION
# ============================================================================
SELENIUM_URL=https://rmc.adhimix.web.id/web/login
SELENIUM_USER=oenoseven@gmail.com
SELENIUM_PASSWORD=Odoo2026

# ============================================================================
# APPLICATION CONFIGURATION (OPTIONAL)
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=development

# ============================================================================
# ADVANCED OPTIONS (Optional)
# ============================================================================
# Database connection timeout in seconds
DB_CONNECT_TIMEOUT=10

# Database statement timeout in seconds
DB_STATEMENT_TIMEOUT=30

# Connection pool size
DB_POOL_SIZE=5

# Connection pool overflow
DB_POOL_OVERFLOW=10
