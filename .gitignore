# .gitignore - Add this to exclude credentials

# Environment variables (contains secrets)
.env
.env.local
.env.*.local

# IDE and system files
.vscode/
.idea/
*.swp
*.swo
*.swn
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Database and cache files
*.db
*.sqlite
*.sqlite3

# Build and distribution
build/
dist/
*.egg-info/
.eggs/

# OS specific
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Application specific
Output/*
!Output/.gitkeep
chromedriver.exe
automation_log.txt
bjdt_error_log.txt
daemonSync.log
aplikasiAlatUji.log
