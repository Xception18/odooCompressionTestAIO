# .gitignore - Add this to exclude credentials

# Environment variables (contains secrets)
.env
.env.local
.env.*.local

# IDE and system files
.vscode/
.idea/
*.swp
*.swo
*.swn
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Database and cache files
*.db
*.sqlite
*.sqlite3

# Build and distribution
build/
dist/
*.egg-info/
.eggs/

# OS specific
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Application specific
Output/*
!Output/.gitkeep
chromedriver.exe
automation_log.txt
bjdt_error_log.txt
daemonSync.log
aplikasiAlatUji.log

# Excel test data and reports (sensitive business data)
Data Input Pengujian/**/*.xlsx
Rencana/Lap. Rencana Test/**
!**/README.md

# Legacy config files (replaced by .env)
config.cnf

# Web migration artifacts (generated during development)
web-migration/backend/.venv/
web-migration/backend/__pycache__/
web-migration/frontend/node_modules/
web-migration/frontend/dist/
web-migration/frontend/.vite/
